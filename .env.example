# Copie este arquivo para .env e ajuste conforme o ambiente.
# O docker-compose.yml le automaticamente um .env na mesma pasta.

SERVER_PORT=8080

# Vazio = profile padrao (dev). Use "prod" para o profile de producao
# (sem SQL no log, console do H2 desativado por padrao).
SPRING_PROFILES_ACTIVE=

SPRING_DATASOURCE_URL=jdbc:h2:file:./data/demodb;AUTO_SERVER=TRUE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
SPRING_H2_CONSOLE_ENABLED=true

# Para rodar contra o Postgres do docker-compose.yml em vez do H2, descomente
# as 4 linhas abaixo (o servico "postgres" ja sobe junto com "docker compose
# up"; o hostname "postgres" so resolve de dentro da rede do compose):
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/devopsac1
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=devopsac1
# SPRING_DATASOURCE_PASSWORD=use-a-local-password

# Required by Docker Compose. Put actual values in the ignored .env file or
# provide them through Jenkins Secret Text credentials. Never commit .env.
POSTGRES_PASSWORD=replace-with-local-password
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=replace-with-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-password
